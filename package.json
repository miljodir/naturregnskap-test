{
  "name": "naturregnskap-demo",
  "private": true,
  "description": "Verktøy til utvikling. Selve siden trenger ikke noe av dette: den er rene filer uten byggesteg.",
  "scripts": {
    "formater": "prettier --write js stil.css verktoy/*.js",
    "sjekk-format": "prettier --check js stil.css verktoy/*.js",
    "test": "node verktoy/regresjon.js ut/ny --mot HEAD",
    "sjekk": "node verktoy/sjekk-navn.js && node verktoy/sjekk-regning.js",
    "md-css": "node verktoy/md-css.js"
  },
  "devDependencies": {
    "@miljodirektoratet/md-css": "6.32.0",
    "acorn": "^8.0.0",
    "acorn-walk": "^8.0.0",
    "eslint-scope": "^9.0.0",
    "playwright": "^1.50.0",
    "prettier": "3.9.9"
  }
}
